# EditorConfig — the API runs in Linux containers while the frontend is often edited on
# Windows. Normalising here keeps CRLF out of shell scripts and Dockerfile stages.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{glb,gz,bin,png,jpg,jpeg,ico,woff,woff2,ipynb}]
insert_final_newline = unset
trim_trailing_whitespace = unset