# ─────────────────────────────────────────────────────────────────────────────
# Fleet Digital Twin — copy to .env and edit.  `cp .env.example .env`
# .env is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Signs every JWT. Generate with:  openssl rand -hex 32
# The API refuses to start in production while this holds the placeholder value.
FDT_JWT_SECRET=change-me-to-a-long-random-string

# ── Compose wiring ────────────────────────────────────────────────────────────
POSTGRES_USER=fdt
POSTGRES_PASSWORD=fdt
POSTGRES_DB=fdt

# Host ports. The database and API bind to loopback only in development; the
# production override removes both.
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5433

# ── API behaviour ─────────────────────────────────────────────────────────────
# development | staging | production. In production the API refuses to boot on the
# committed development JWT secret. FDT_DEMO_MODE is not restricted by this: it picks a
# telemetry source, not a security posture.
FDT_ENVIRONMENT=development
FDT_LOG_LEVEL=INFO

# Replay engine: advances every aircraft one C-MAPSS cycle per tick and streams the
# result over the WebSocket. Turn it off only when something real posts to
# POST /api/v1/telemetry — otherwise the digital twin never moves.
FDT_DEMO_MODE=true
FDT_DEMO_TICK_SECONDS=1.2

# Remaining-useful-life cap, in cycles (business rule 26).
FDT_RUL_CAP=125

# Storage retention. The replay engine appends four rows per aircraft per tick and
# nothing else deletes them: ~5.4 KB per aircraft-tick, ~36 KB/s across the seeded
# fleet, ~93 GB a month. On the 1 GB free cloud plan that fills the disk in about eight
# hours. 1 h holds ~141 MB steady state and still covers every cycle one engine
# produces (~17x over), so the history chart sees no gaps. 0 disables the pruner —
# fine locally, a disk-exhaustion bug on a small managed instance.
# See backend/app/services/retention.py and docs/11 §13.2.
FDT_TELEMETRY_RETENTION_HOURS=1
FDT_RETENTION_INTERVAL_SECONDS=300

# Seed the fleet on boot when the database is empty. For deployments where nobody can
# shell in and run `python -m app.seed.run` — a Render free service, for instance.
# No-ops once any aircraft exists, so it costs one COUNT per cold start.
FDT_SEED_ON_BOOT=false

# Browser origins allowed to call the API directly. Empty in production, where the
# browser only ever talks to the same origin through nginx.
# 127.0.0.1 is listed alongside localhost on purpose: the WebSocket origin check
# closes with 4408 on anything not listed here, so opening the console at
# http://127.0.0.1:8080 instead of http://localhost:8080 silently loses the live
# stream even though the page itself loads.
FDT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# ── ML ────────────────────────────────────────────────────────────────────────
# Which trained generation to serve. The loader resolves the artifact set from this
# value; see docs/15-serving-the-pooled-model.md.
#
#   all      pooled over FD001–FD004, 32 features, z-scored per regime   (default)
#   full     FD001 only, 29 features, z-scored per regime
#   holdout  FD001 80/20 split, 29 features, StandardScaler preprocessing
#
# Do NOT set FDT_ML_MODEL_PATH. An explicit path overrides only the model while the
# contract still resolves from the variant, so the two end up describing different
# directories and the API silently degrades to the deterministic fallback.
FDT_ML_VARIANT=all
FDT_ML_DATASET=FD001

# Answer from the deterministic rul = 125 − cycle curve when no artifact is staged.
# Keep true: the demo must stay interactive without the boosters.
FDT_ML_FALLBACK=true

# Where `make fetch-model` (the `model-fetch` compose job) downloads the trained
# boosters from. Artifacts are addressed as <base-url>/<variant>/<file>, e.g.
#   $FDT_ML_ARTIFACTS_URL/https://example.com/ml/artifacts
#   -> https://example.com/ml/artifacts/all/xgboost_all_full.json
#
# C-MAPSS is fetched from a public NASA mirror by scripts/fetch-cmapss.sh; the boosters
# are not on any public mirror, so this has no default. Left empty, a fresh checkout
# boots with no model and every prediction comes from `rul = 125 - cycle` — /healthz
# reports `degraded`, which is the signal to come back here.
FDT_ML_ARTIFACTS_URL=

# ── Resource ceilings (production override only) ──────────────────────────────
API_CPUS=2.0
API_MEMORY=2g
WEB_CPUS=1.0
WEB_MEMORY=256m

# ── Frontend dev server only ───────────────────────────────────────────────────
# Vite proxies /api and /ws here in development, so the browser origin matches
# production and CORS never enters the picture. Ignored by the frontend image.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Shows the "Continue as the demo commander" shortcut on the sign-in screen. Absent
# from a production build unless explicitly set to true, which is the safe default:
# the shortcut ships committed fixture credentials to anyone who loads the page.
# VITE_DEMO_MODE=true

# ── Tests ─────────────────────────────────────────────────────────────────────
# The pytest suite DROPS AND RECREATES the public schema. Point this at a disposable
# database only — `make db-test` starts one.
# FDT_TEST_DATABASE_URL=postgresql+psycopg://fdt:fdt@localhost:5433/fdt_test