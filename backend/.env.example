# API environment — see the repository root .env.example for the Compose variables.
#
# When running the API directly (not through Docker), copy this file to backend/.env:
#   cp .env.example .env
#
# Under Docker these values come from docker-compose.yml and this file is ignored.

FDT_ENVIRONMENT=development
FDT_DATABASE_URL=postgresql+psycopg://fdt:fdt@localhost:5433/fdt
FDT_LOG_LEVEL=INFO

# Signs every JWT. Generate a real one:  openssl rand -hex 32
# The API refuses to start with the placeholder while FDT_ENVIRONMENT=production.
FDT_JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed to call the API cross-origin. Under Docker the browser only
# talks to nginx on the same origin, so this is mainly for `npm run dev` against a
# locally running API.
# 127.0.0.1 is listed alongside localhost on purpose: the WebSocket origin check
# closes with 4408 on anything not listed here, so opening the console at
# http://127.0.0.1:8080 instead of http://localhost:8080 silently loses the live
# stream even though the page itself loads.
FDT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Replay engine: one C-MAPSS cycle per aircraft per tick, streamed over the WebSocket.
# Must be false in production.
FDT_DEMO_MODE=true
FDT_DEMO_TICK_SECONDS=1.2

# Remaining-useful-life cap in cycles (business rule 26).
FDT_RUL_CAP=125

# Which trained generation to serve. The loader resolves the whole artifact set from
# this value — see docs/15-serving-the-pooled-model.md.
#
#   all      pooled over FD001–FD004, 32 features, z-scored per regime   (default)
#   full     FD001 only, 29 features, z-scored per regime
#   holdout  FD001 80/20 split, 29 features, StandardScaler preprocessing
#
# Do NOT set FDT_ML_MODEL_PATH / FDT_ML_CONTRACT_PATH here. An explicit path overrides
# only one of the two, so they end up describing different directories and the loader
# silently falls back to the deterministic rul = 125 − cycle curve with a perfectly
# valid model sitting on disk unused.
FDT_ML_VARIANT=all
FDT_ML_DATASET=FD001
FDT_ML_FALLBACK=true

# Resolved relative to the process CWD. The container sets this to /app/data.
FDT_DATA_DIR=data

# The built Vite bundle, served by this process when there is no nginx in front of it
# (docs/11 §13). Unset or missing means "serve the API only"; it is never an error.
# Must be absolute when the process runs from backend/, as it does for alembic.
# FDT_WEB_DIST=/opt/render/project/src/frontend/dist

# Storage retention — see the root .env.example and docs/11 §13.2. The replay engine's
# append-only tables are otherwise unbounded.
FDT_TELEMETRY_RETENTION_HOURS=1
FDT_RETENTION_INTERVAL_SECONDS=300